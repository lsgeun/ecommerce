{
  "permissions": {
    "defaultMode": "manual",
    "allow": [
      "Bash(./gradlew test*)",
      "Bash(./gradlew *Test)",
      "Bash(./gradlew compileJava*)",
      "Bash(./gradlew compileTestJava*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)"
    ],
    "ask": [
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(rm *)",
      "Bash(docker*)"
    ],
    "deny": [
      "Bash(ssh *)",
      "Bash(git push --force*)",
      "Bash(git reset --hard*)",
      "Bash(git clean*)"
    ]
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
        ]
      }
    ]
  }
}
